# 复制一份改名为 .env，再按需修改

# 用哪个大模型：claude / openai_compat / mock
#   mock 不调用任何大模型，只复述听到的话，用来先把硬件和语音链路跑通
LLM_PROVIDER=mock

# ---- Claude（需要能访问 Anthropic API 的网络）----
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# ---- 国内模型：任何兼容 OpenAI 接口的多模态模型 ----
# 下面是阿里云百炼（通义千问 VL）的写法；豆包、智谱等把地址、Key、模型名换掉即可
# OPENAI_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPAT_API_KEY=sk-...
# OPENAI_COMPAT_MODEL=qwen-vl-max

# ---- 语音识别（本地 faster-whisper，不花钱）----
# 模型越大越准越慢：tiny / base / small / medium
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh
# 国内下载模型慢或失败，打开下面这行走镜像
# HF_ENDPOINT=https://hf-mirror.com

# ---- 语音合成（edge-tts，不花钱）----
# 其他音色：zh-CN-YunxiNeural（男声）、zh-CN-XiaoyiNeural 等
TTS_VOICE=zh-CN-XiaoxiaoNeural
